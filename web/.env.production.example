# Production environment variables for the frontend build
# Copy this file to .env.production and replace the placeholders.
# These are consumed at build-time by Vite.

# Base URL of your Azure Functions app (no trailing slash)
# Example: https://bga-tm-functions.azurewebsites.net
VITE_API_BASE=https://YOUR_FUNCTION_APP.azurewebsites.net

# Azure Functions key if your functions use AuthorizationLevel.Function
VITE_FUNCTIONS_KEY=YOUR_FUNCTIONS_KEY

# API root of the game engine (tm-engine) Functions app, for "Play from here" in the replay viewer.
# Example: https://tm-engine.azurewebsites.net/api
VITE_ENGINE_API_BASE=https://YOUR_ENGINE_APP.azurewebsites.net/api
VITE_ENGINE_FUNCTIONS_KEY=YOUR_ENGINE_FUNCTIONS_KEY
